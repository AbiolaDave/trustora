# Copy to .env.local and fill in. Never commit .env.local.
NODE_ENV=development
APP_URL=http://localhost:3000

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Paystack (use TEST keys until you are ready to go live). Leave blank in dev to use the labelled mock provider.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Gmail sending (needs 2-Step Verification, then create an App Password: myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
APP_NAME=Trustora

# Secret for the scheduled sweeper (expires stale bookings). Any long random string.
CRON_SECRET=

# Optional: WhatsApp support number in international format without +, e.g. 2348012345678
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Private file storage. Set all three to store uploads as authenticated Cloudinary assets.
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Used only by `npm run seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Only for `npm run seed -- --demo`
SEED_DEMO_PASSWORD=''
